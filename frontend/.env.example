# Backend API (production builds)
# REACT_APP_API_URL=https://hamikdah-site.onrender.com

# Admin Panel Credentials
# REACT_APP_ADMIN_USERNAME=
# REACT_APP_ADMIN_PASSWORD=

# Microsoft Clarity — session replay & heatmaps
# Get the Project ID from: Clarity project → Settings → Overview
# Create React App only exposes REACT_APP_* vars to the browser
REACT_APP_CLARITY_PROJECT_ID=

# Google Tag Manager (GA4 and other tags). Loaded only after analytics consent.
# Defaults to GTM-N8G5ZP2F if unset.
# REACT_APP_GTM_ID=GTM-N8G5ZP2F

# Google Ads conversion tracking (loaded only after advertising consent)
# Ads ID: Google Ads → Tools → Google tag (format AW-XXXXXXXXX)
# Conversion label: Google Ads → Goals → Conversions → your Purchase conversion → Tag setup
REACT_APP_GOOGLE_ADS_ID=
REACT_APP_GOOGLE_ADS_CONVERSION_LABEL=

# Meta Pixel (Facebook / Instagram) — future; loaded after advertising consent
# REACT_APP_META_PIXEL_ID=
